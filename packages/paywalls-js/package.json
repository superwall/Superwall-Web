{
  "name": "@superwall/paywalls-js",
  "version": "0.2.2",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./dist/browser/auto.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@superwall/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "@superwall/source": "./src/browser/index.ts",
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./browser/auto": {
      "@superwall/source": "./src/browser/auto.ts",
      "types": "./dist/browser/auto.d.ts",
      "import": "./dist/browser/auto.js",
      "default": "./dist/browser/auto.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "bun run ../../scripts/build-package.ts",
    "clean": "rm -rf dist node_modules .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@superwall/core": "workspace:^",
    "@superwall/superscript": "^1.0.2",
    "effect": "^3.18.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.40.0",
    "@effect/vitest": "^0.29.0",
    "@happy-dom/global-registrator": "^15.0.0",
    "@types/bun": "latest",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
