{
  "name": "@superwall/web2app",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@superwall/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "bun run ../../scripts/build-package.ts",
    "clean": "rm -rf dist node_modules .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@superwall/paywalls-js": "workspace:^"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
