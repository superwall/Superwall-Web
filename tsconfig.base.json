{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    // Resolve workspace @superwall/* deps to their .ts source in-repo (editor
    // go-to-def, typecheck, declaration emit) via the matching `exports`
    // condition. Published consumers lack this condition and get dist/ instead.
    "customConditions": ["@superwall/source"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [{ "name": "@effect/language-service" }]
  }
}
